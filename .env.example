# dutchbook environment
#
# Copy to `.env` and adjust. Variables marked REQUIRED have no default; the
# process refuses to start without them and reports all of them at once.
# The defaults below match the services in docker-compose.yml.

# Runtime mode. One of: development | test | production
# Controls log formatting (pretty in development, JSON otherwise).
# Optional. Default: development
NODE_ENV=development

# Minimum log level to emit.
# One of: fatal | error | warn | info | debug | trace | silent
# Optional. Default: info
LOG_LEVEL=debug

# Interface the HTTP server binds to. Use 0.0.0.0 in containers.
# Optional. Default: 0.0.0.0
HOST=0.0.0.0

# TCP port for the HTTP server. 1-65535.
# Optional. Default: 3000
PORT=3000

# REQUIRED. Postgres connection string (postgres:// or postgresql://).
DATABASE_URL=postgresql://dutchbook:dutchbook@localhost:5432/dutchbook

# Maximum Postgres connections held by the pool. 1-100.
# Optional. Default: 10
DATABASE_POOL_MAX=10

# REQUIRED. Redis connection string (redis:// or rediss://).
# Backs the BullMQ queues.
REDIS_URL=redis://localhost:6379

# Per-dependency deadline for the GET /health probes, in milliseconds. 50-30000.
# A probe that exceeds this counts as a failure and /health returns 503.
# Optional. Default: 2000
HEALTHCHECK_TIMEOUT_MS=2000

# Grace period for draining in-flight work on SIGTERM/SIGINT, in milliseconds.
# 100-120000. The process force-exits once it elapses.
# Optional. Default: 10000
SHUTDOWN_TIMEOUT_MS=10000

# Extra grace, on top of SHUTDOWN_TIMEOUT_MS, for a running job to finish before
# exit. 0-600000. A catalog crawl takes minutes, so it needs its own budget; the
# HTTP server's ten seconds would kill one mid-batch on every deploy. A job still
# running at this deadline is returned to the queue for another replica.
# Optional. Default: 60000
JOB_DRAIN_TIMEOUT_MS=60000

# Whether this process runs the catalog ingest worker.
# One of: true | false | 1 | 0 | yes | no
# Set false on web-only replicas so scaling HTTP does not multiply crawlers.
# Optional. Default: true
CATALOG_INGEST_ENABLED=true

# Polymarket Gamma base URL. Point at a recorded-payload stub for staging or for
# the crash-recovery drill; never change it in production.
# Optional. Default: https://gamma-api.polymarket.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Markets per transaction. 1-5000. Smaller means a crash loses less work and the
# recovery run has less to redo; larger amortises round-trips.
# Optional. Default: 250
CATALOG_INGEST_BATCH_SIZE=250

# How often the repeatable catalog ingest fires, in milliseconds. 60000-86400000.
# Overlapping runs are impossible regardless: a Redis lock spans all replicas, so
# a crawl that outlasts its interval simply makes the next tick skip.
# Optional. Default: 600000 (10 minutes)
CATALOG_INGEST_INTERVAL_MS=600000

# Hard deadline for one ingest run, in milliseconds. 10000-3600000.
# On expiry the run is aborted mid-request and the job retried.
# Optional. Default: 1200000 (20 minutes)
CATALOG_INGEST_TIMEOUT_MS=1200000

# Total attempts per job, including the first. 1-10.
# Exhausting them moves the job to the catalog-ingest-dlq dead letter queue.
# Optional. Default: 3
CATALOG_INGEST_ATTEMPTS=3

# Base delay for the exponential backoff between attempts, in ms. 1000-600000.
# Optional. Default: 30000
CATALOG_INGEST_BACKOFF_MS=30000

# Lifetime of the cross-instance run lock, in milliseconds. 5000-600000.
# Renewed continuously while a job runs, so this bounds only how long a *crashed*
# instance blocks the next run — not how long a run may take.
# Optional. Default: 60000
CATALOG_INGEST_LOCK_TTL_MS=60000
