# dutchbook environment
#
# Copy to `.env` and adjust. Variables marked REQUIRED have no default; the
# process refuses to start without them and reports all of them at once.
# The defaults below match the services in docker-compose.yml.

# Runtime mode. One of: development | test | production
# Controls log formatting (pretty in development, JSON otherwise).
# Optional. Default: development
NODE_ENV=development

# Minimum log level to emit.
# One of: fatal | error | warn | info | debug | trace | silent
# Optional. Default: info
LOG_LEVEL=debug

# Interface the HTTP server binds to. Use 0.0.0.0 in containers.
# Optional. Default: 0.0.0.0
HOST=0.0.0.0

# TCP port for the HTTP server. 1-65535.
# Optional. Default: 3000
PORT=3000

# REQUIRED. Postgres connection string (postgres:// or postgresql://).
DATABASE_URL=postgresql://dutchbook:dutchbook@localhost:5432/dutchbook

# Maximum Postgres connections held by the pool. 1-100.
# Optional. Default: 10
DATABASE_POOL_MAX=10

# REQUIRED. Redis connection string (redis:// or rediss://).
# Backs the BullMQ queues.
REDIS_URL=redis://localhost:6379

# Per-dependency deadline for the GET /health probes, in milliseconds. 50-30000.
# A probe that exceeds this counts as a failure and /health returns 503.
# Optional. Default: 2000
HEALTHCHECK_TIMEOUT_MS=2000

# Grace period for draining in-flight work on SIGTERM/SIGINT, in milliseconds.
# 100-120000. The process force-exits once it elapses.
# Optional. Default: 10000
SHUTDOWN_TIMEOUT_MS=10000

# Extra grace, on top of SHUTDOWN_TIMEOUT_MS, for a running job to finish before
# exit. 0-600000. A catalog crawl takes minutes, so it needs its own budget; the
# HTTP server's ten seconds would kill one mid-batch on every deploy. A job still
# running at this deadline is returned to the queue for another replica.
# Optional. Default: 60000
JOB_DRAIN_TIMEOUT_MS=60000

# Whether this process runs the catalog ingest worker.
# One of: true | false | 1 | 0 | yes | no
# Set false on web-only replicas so scaling HTTP does not multiply crawlers.
# Optional. Default: true
CATALOG_INGEST_ENABLED=true

# Polymarket Gamma base URL. Point at a recorded-payload stub for staging or for
# the crash-recovery drill; never change it in production.
# Optional. Default: https://gamma-api.polymarket.com
GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Markets per transaction. 1-5000. Smaller means a crash loses less work and the
# recovery run has less to redo; larger amortises round-trips.
# Optional. Default: 250
CATALOG_INGEST_BATCH_SIZE=250

# How often the repeatable catalog ingest fires, in milliseconds. 60000-86400000.
# Overlapping runs are impossible regardless: a Redis lock spans all replicas, so
# a crawl that outlasts its interval simply makes the next tick skip.
# Optional. Default: 600000 (10 minutes)
CATALOG_INGEST_INTERVAL_MS=600000

# Hard deadline for one ingest run, in milliseconds. 10000-3600000.
# On expiry the run is aborted mid-request and the job retried.
# Optional. Default: 1200000 (20 minutes)
CATALOG_INGEST_TIMEOUT_MS=1200000

# Total attempts per job, including the first. 1-10.
# Exhausting them moves the job to the catalog-ingest-dlq dead letter queue.
# Optional. Default: 3
CATALOG_INGEST_ATTEMPTS=3

# Base delay for the exponential backoff between attempts, in ms. 1000-600000.
# Optional. Default: 30000
CATALOG_INGEST_BACKOFF_MS=30000

# Lifetime of the cross-instance run lock, in milliseconds. 5000-600000.
# Renewed continuously while a job runs, so this bounds only how long a *crashed*
# instance blocks the next run — not how long a run may take.
# Optional. Default: 60000
CATALOG_INGEST_LOCK_TTL_MS=60000

# --- LLM-assisted relation proposals ------------------------------------------
# Read only by `pnpm relations:propose` and `pnpm relations:calibrate`, which are
# hand-run tools. The service itself never calls an LLM, so the deployed process
# does not need this and the ingest keeps working without it.
#
# Never commit a real key: `.env` is gitignored, `.env.example` is not.
# Optional. No default.
ANTHROPIC_API_KEY=

# Recorded on every verdict, so a precision figure has a named judge.
# Optional. Default: $USER
REVIEWER=

# --- Coherence checking -------------------------------------------------------
# Whether the coherence checker runs. Independent of the ingest switch: the check
# is far cheaper than a full crawl, so it is worth being able to keep scanning
# while the catalog crawl is paused.
# Optional. Default: true
COHERENCE_CHECK_ENABLED=true

# How often the check fires, in milliseconds. 10000-3600000.
# Sixty seconds — fast enough that a violation lasting a couple of minutes is
# caught with several observations, which is the resolution lifetime needs.
# Optional. Default: 60000
COHERENCE_CHECK_INTERVAL_MS=60000

# Hard deadline for one check. Under the interval, so runs cannot pile up.
# Optional. Default: 45000
COHERENCE_CHECK_TIMEOUT_MS=45000

# Lifetime of the cross-instance coherence lock, in milliseconds.
# Optional. Default: 90000
COHERENCE_CHECK_LOCK_TTL_MS=90000

# Screening threshold in probability. Below this a gap is indistinguishable from
# the venue's tick size, so it is rounding rather than mispricing.
# Optional. Default: 0.005
COHERENCE_EPSILON=0.005

# Constraints promoted to the expensive confirmation stage per run, worst first.
# Caps the order-book spend when a stale quote cache makes everything look wrong.
# Optional. Default: 25
COHERENCE_MAX_CONFIRMATIONS=25

# --- Market feed --------------------------------------------------------------
# Whether stage 1 is driven by the live CLOB order-book feed. Off falls back to
# screening cached Gamma quotes on the schedule, which works and is slow. Worth
# keeping switchable: this is the component most exposed to a vendor protocol
# change, and a bad deploy should be one env var from the old behaviour.
# Optional. Default: true
MARKET_FEED_ENABLED=true

# Assets per websocket. Not a venue limit — one socket accepted all 25,548
# tokens under constraint. It is a blast radius: the asset set is fixed for the
# life of a connection, so this is the unit that gets rebuilt and the unit one
# dropped socket takes offline.
# Optional. Default: 2500
MARKET_FEED_SHARD_SIZE=2500

# Heartbeat cadence, in milliseconds. The venue answers `PING` with `PONG`, and
# on a shard of quiet markets that is the only thing separating a silent
# connection from a dead one.
# Optional. Default: 10000
MARKET_FEED_PING_INTERVAL_MS=10000

# Silence after which a connection is presumed dead and recycled. Must exceed
# the ping interval by enough that one lost PONG is not a reconnect.
# Optional. Default: 30000
MARKET_FEED_STALE_TIMEOUT_MS=30000

# How often a slice of in-memory books is compared against fresh REST snapshots,
# and how many per pass.
#
# Sized from measurement. Book drift is not a rare anomaly: roughly 1% of
# hash-gated comparisons find a book that missed an update, and the rate scales
# with subscription size. The sweep period therefore bounds how long a drifted
# book can price stage 1. These defaults sweep a 12,500-token feed end to end in
# ~2.5 minutes, costing 25 requests per 30s against a 50/s ceiling on POST /books.
# Optional. Defaults: 30000 ms, 2500 books
MARKET_FEED_RECONCILE_INTERVAL_MS=30000
MARKET_FEED_RECONCILE_BATCH=2500

# Debounce between a book update and re-screening the constraints it touches.
# Long enough that a burst of levels on one market is one evaluation, short
# enough to stay irrelevant against the five-second detection target.
# Optional. Default: 250
MARKET_FEED_SCREEN_DEBOUNCE_MS=250

# Floor between feed-triggered checks. Detections arrive in bursts when a whole
# event re-prices, and they all want the same single two-stage check.
# Optional. Default: 5000
MARKET_FEED_TRIGGER_COOLDOWN_MS=5000

# How often the subscription is rebuilt from the constraint graph. New markets
# arrive with the ten-minute ingest, and the asset set cannot be changed on a
# live socket, so picking them up means reconnecting.
# Optional. Default: 900000
MARKET_FEED_REFRESH_INTERVAL_MS=900000

# --- Alerting -----------------------------------------------------------------
# Discord incoming webhook. Absent is not silence: alerts fall back to the log,
# so every threshold, cooldown and escalation rule still runs and is observable.
# Optional. No default.
DISCORD_WEBHOOK_URL=

# Minimum gap between two messages about the same violation, in milliseconds.
# Thirty minutes. A violation that persists is one fact, not one fact per check
# cycle — at a 60s cadence the naive version would send 30 messages an hour.
# Optional. Default: 1800000
ALERT_COOLDOWN_MS=1800000

# Growth in net edge that justifies breaking the cooldown silence. 1-100.
# Doubling is a materially different opportunity; 10% more is the same one.
# Optional. Default: 2
ALERT_ESCALATION_FACTOR=2

# Floors a confirmed violation must clear to be worth notifying about. Below
# these it is real, recorded, and not worth waking anyone for.
# Optional. Defaults: 0.01 (1c per unit) and 5 (dollars)
ALERT_MIN_NET_EDGE=0.01
ALERT_MIN_NET_PROFIT=5

# How far back to look for resolutions still owed a follow-up, in milliseconds.
# Bounded so switching alerting on does not replay months of closed episodes.
# Optional. Default: 86400000
ALERT_RESOLUTION_LOOKBACK_MS=86400000

# --- Alerting: system health --------------------------------------------------
# Ingest silence that counts as broken, in milliseconds.
# Optional. Default: 1800000
ALERT_INGEST_STALE_MS=1800000

# Rate-limit (429) responses within the window that count as a spike.
# Optional. Defaults: 50 hits in 600000 ms
ALERT_RATE_LIMIT_HITS=50
ALERT_RATE_LIMIT_WINDOW_MS=600000

# Coherence queue depth beyond which further growth is a problem. Depth alone is
# not: one check waiting is normal. Depth that grows check over check is not.
# Optional. Default: 5
ALERT_QUEUE_DEPTH=5

# Share of Gamma records failing zod validation that counts as a schema change.
# The early warning that the vendor altered their response shape.
# Optional. Default: 0.05
ALERT_PARSE_FAILURE_RATE=0.05
